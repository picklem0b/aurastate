generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ── Users ─────────────────────────────────────────────────
model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  clerkId     String   @unique
  email       String   @unique
  username    String   @unique
  fullName    String
  region      String   @default("ZA_WC")
  province    String   @default("WC")
  grade       Int      @default(10)
  stream      String   @default("science")
  language    String   @default("en")
  isOnboarded Boolean  @default(false)
  auraColor   String   @default("blue")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("users")
}

// ── User Subjects ─────────────────────────────────────────
model UserSubject {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  subjectCode String
  subjectName String
  masteryPct  Float    @default(0)
  isMandatory Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([userId, subjectCode])
  @@index([userId])
  @@map("user_subjects")
}

// ── Weak Points ───────────────────────────────────────────
model WeakPoint {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  subject    String
  concept    String
  masteryPct Float    @default(0)
  flaggedAt  DateTime @default(now())
  resolved   Boolean  @default(false)

  @@index([userId])
  @@map("weak_points")
}

// ── Focus Sessions ────────────────────────────────────────
model FocusSession {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  subject     String
  elapsedSecs Int       @default(0)
  xpEarned    Int       @default(0)
  xpLost      Int       @default(0)
  meltdowns   Int       @default(0)
  voided      Boolean   @default(false)
  startedAt   DateTime  @default(now())
  endedAt     DateTime?

  @@index([userId])
  @@map("focus_sessions")
}

// ── Streaks ───────────────────────────────────────────────
model Streak {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @unique @db.ObjectId
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastStudyDate  String
  totalStudyDays Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@map("streaks")
}

// ── Curriculum Topics ─────────────────────────────────────
model CurriculumTopic {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  subjectCode String
  grade       Int
  topicName   String
  topicIndex  Int
  examWeight  Float  @default(1.0)
  description String @default("")

  @@unique([subjectCode, grade, topicName])
  @@index([subjectCode, grade])
  @@map("curriculum_topics")
}

// ── Study Materials ───────────────────────────────────────
model StudyMaterial {
  id               String @id @default(auto()) @map("_id") @db.ObjectId
  topicId          String @db.ObjectId
  title            String
  summary          String
  formulas         String @default("[]")
  examples         String @default("[]")
  examTips         String @default("[]")
  difficultyRating Float  @default(0)
  pastPaperLinks   String @default("[]")

  @@index([topicId])
  @@map("study_materials")
}

// ── Study Progress ────────────────────────────────────────
model StudyProgress {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  topicId    String   @db.ObjectId
  completed  Boolean  @default(false)
  quizScore  Int?
  lastStuded DateTime @default(now())

  @@unique([userId, topicId])
  @@index([userId])
  @@map("study_progress")
}

// ── War Rooms ─────────────────────────────────────────────
model WarRoom {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  subjectCode String?
  grade       Int?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("war_rooms")
}

// ── War Room Messages ─────────────────────────────────────
model WarRoomMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId    String   @db.ObjectId
  userId    String
  content   String
  threadId  String?
  createdAt DateTime @default(now())
  editedAt  DateTime?
  deleted   Boolean  @default(false)

  @@index([roomId])
  @@map("war_room_messages")
}

# ─── Database (MongoDB Atlas) ─────────────────────────────
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/aurastate

# ─── Clerk Auth ───────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# ─── OpenRouter AI ────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...

# ─── App URLs ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.aurastate.app
NEXT_PUBLIC_APP_URL=https://aurastate.app

# ─── Redis (Upstash) ─────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ─── CORS ─────────────────────────────────────────────────
ALLOWED_ORIGINS=https://aurastate.app

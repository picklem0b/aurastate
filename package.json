{
  "name": "aurastate",
  "version": "1.0.0-alpha",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:push": "pnpm --filter @aurastate/database db:push",
    "db:generate": "pnpm --filter @aurastate/database generate",
    "db:migrate": "pnpm --filter @aurastate/database db:migrate",
    "db:seed": "pnpm --filter @aurastate/database db:seed",
    "db:studio": "pnpm --filter @aurastate/database db:studio",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky install"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "husky": "^9.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}

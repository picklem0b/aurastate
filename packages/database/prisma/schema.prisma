generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ─────────────────────────────────────────────────────
model User {
  id           String   @id                  // Clerk user ID
  fullName     String
  username     String   @unique
  email        String   @unique
  region       String   @default("ZA_WC")
  province     String   @default("WC")
  grade        Int      @default(10)
  stream       String   @default("science")
  isOnboarded  Boolean  @default(false)
  auraColor    String   @default("blue")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subjects     UserSubject[]
  weakPoints   WeakPoint[]
  focusSessions FocusSession[]
  quizAttempts QuizAttempt[]
  memberships  RoomMember[]
  messages     Message[]

  @@map("users")
}

// ── Subjects & Mastery ────────────────────────────────────────
model UserSubject {
  id          Int      @id @default(autoincrement())
  userId      String
  subjectName String
  masteryPct  Float    @default(0)
  isMandatory Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  concepts    ConceptMastery[]

  @@unique([userId, subjectName])
  @@map("user_subjects")
}

model ConceptMastery {
  id          Int      @id @default(autoincrement())
  subjectId   Int
  concept     String
  masteryPct  Float    @default(50)
  attempts    Int      @default(0)
  isFlagged   Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  subject     UserSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, concept])
  @@map("concept_mastery")
}

model WeakPoint {
  id         Int      @id @default(autoincrement())
  userId     String
  subject    String
  concept    String
  masteryPct Float    @default(0)
  resolved   Boolean  @default(false)
  flaggedAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("weak_points")
}

// ── Focus Sessions ────────────────────────────────────────────
model FocusSession {
  id            String   @id @default(cuid())
  userId        String
  subject       String
  elapsedSecs   Int      @default(0)
  xpEarned      Int      @default(0)
  xpLost        Int      @default(0)
  meltdowns     Int      @default(0)
  voided        Boolean  @default(false)
  startedAt     DateTime @default(now())
  endedAt       DateTime?

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("focus_sessions")
}

// ── Quiz Attempts ─────────────────────────────────────────────
model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  subject     String
  topic       String
  score       Int
  total       Int
  masteryPct  Float
  weakConcepts String[]
  takenAt     DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("quiz_attempts")
}

// ── Social / War Rooms ────────────────────────────────────────
model Room {
  id          String   @id @default(cuid())
  name        String
  description String?
  isPublic    Boolean  @default(true)
  subject     String?
  createdAt   DateTime @default(now())

  members     RoomMember[]
  messages    Message[]
  @@map("rooms")
}

model RoomMember {
  id        Int      @id @default(autoincrement())
  userId    String
  roomId    String
  role      String   @default("member")  // member | moderator | owner
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  @@unique([userId, roomId])
  @@map("room_members")
}

model Message {
  id        String   @id @default(cuid())
  userId    String
  roomId    String
  content   String
  threadId  String?
  createdAt DateTime @default(now())
  editedAt  DateTime?
  deleted   Boolean  @default(false)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  @@map("messages")
}
